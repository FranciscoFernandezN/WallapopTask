BACKEND_HOST=localhost
BACKEND_PORT=3000
# Note that this timeout should be always greater than the AI_MODEL_TIMEOUT
BACKEND_TIMEOUT=35000

FRONTEND_HOST=localhost
FRONTEND_PORT=5173

AI_MODEL_TIMEOUT=30000
AI_MAX_RETRIES=2

# Comma-separated list of AI models to try in order.
# If a model fails after AI_MAX_RETRIES attempts, the next model in the list will be tried.
# Use "MOCK" to use mock responses for testing (keyword-based, 80% valid / 20% invalid).
# Example: AI_MODEL_PROVIDER=openai/gpt-4o,anthropic/claude-3.5-sonnet,google/gemini-pro
AI_MODEL_PROVIDER=openai/gpt-4o,anthropic/claude-3.5-sonnet

# Paste the API key from OpenRouter
AI_MODEL_PROVIDER_API_KEY=
